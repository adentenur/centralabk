NUXT_SESSION_PASSWORD=ganti-dengan-string-acak-minimal-32-karakter

# Lokasi file database SQLite, relatif terhadap folder prisma/.
DATABASE_URL="file:../.data/inventaris.sqlite3"

# Set ke "false" HANYA jika situs diakses lewat http:// tanpa SSL.
# Setelah SSL/HTTPS aktif, hapus baris ini (atau set "true") agar cookie sesi kembali aman.
NUXT_SESSION_SECURE_COOKIE=false
