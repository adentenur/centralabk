NUXT_SESSION_PASSWORD=ganti-dengan-string-acak-minimal-32-karakter

# Supabase connection pooler (dipakai aplikasi saat runtime, mode transaction/pgbouncer).
DATABASE_URL="postgresql://postgres.xxxxxxxx:ganti-dengan-password@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase connection pooler mode session (dipakai Prisma khusus saat migrate/db push).
DIRECT_URL="postgresql://postgres.xxxxxxxx:ganti-dengan-password@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# Set ke "false" HANYA jika situs diakses lewat http:// tanpa SSL.
# Setelah SSL/HTTPS aktif, hapus baris ini (atau set "true") agar cookie sesi kembali aman.
NUXT_SESSION_SECURE_COOKIE=false
