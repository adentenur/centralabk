generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String @map("password_hash")
  nama           String
  role           String @default("admin")
  sessionVersion Int    @default(0) @map("session_version")

  @@map("users")
}

model Setting {
  key       String @id
  value     String
  updatedAt String @map("updated_at")

  @@map("settings")
}

model Item {
  id          Int    @id @default(autoincrement())
  kode        String @unique
  namaBarang  String @map("nama_barang")
  kategori    String @default("")
  namaToko    String @default("") @map("nama_toko")
  jumlah      Int    @default(0)
  satuan      String @default("")
  hargaSatuan Int    @default(0) @map("harga_satuan")
  lokasi      String @default("")
  kondisi     String @default("Baik")
  createdAt   String @map("created_at")
  updatedAt   String @map("updated_at")

  @@map("items")
}

model Satuan {
  id        Int    @id @default(autoincrement())
  nama      String @unique
  createdAt String @map("created_at")

  @@map("satuan")
}

model SuratJalan {
  id           Int              @id @default(autoincrement())
  nomorSurat   String           @map("nomor_surat")
  tanggal      String
  namaPengirim String           @default("") @map("nama_pengirim")
  asalBarang   String           @default("") @map("asal_barang")
  namaPenerima String           @default("") @map("nama_penerima")
  keterangan   String           @default("")
  createdAt    String           @map("created_at")
  updatedAt    String           @map("updated_at")
  items        SuratJalanItem[]

  @@map("surat_jalan")
}

model SuratJalanItem {
  id           Int        @id @default(autoincrement())
  suratJalanId Int        @map("surat_jalan_id")
  suratJalan   SuratJalan @relation(fields: [suratJalanId], references: [id], onDelete: Cascade)
  namaBarang   String     @map("nama_barang")
  jumlah       Int        @default(0)
  satuan       String     @default("")
  urutan       Int        @default(0)

  @@map("surat_jalan_items")
}

model Murid {
  id              Int    @id @default(autoincrement())
  nomorRekamMedis String @default("") @map("nomor_rekam_medis")
  tanggalAsesmen  String @default("") @map("tanggal_asesmen")
  namaAnak        String @map("nama_anak")
  namaPanggilan   String @default("") @map("nama_panggilan")
  tanggalLahir    String @default("") @map("tanggal_lahir")
  jenisKelamin    String @default("") @map("jenis_kelamin")
  namaOrangTua    String @default("") @map("nama_orang_tua")
  nomorTelepon    String @default("") @map("nomor_telepon")
  sekolah         String @default("")
  kelas           String @default("")
  asesmen         Json   @default("{}")
  createdAt       String @map("created_at")
  updatedAt       String @map("updated_at")
  pkbmId          Int?   @map("pkbm_id")
  pkbm            Pkbm?  @relation(fields: [pkbmId], references: [id], onDelete: SetNull)
  dokumen         MuridDokumen[]

  @@map("murid")
}

model MuridDokumen {
  id        Int    @id @default(autoincrement())
  muridId   Int    @map("murid_id")
  murid     Murid  @relation(fields: [muridId], references: [id], onDelete: Cascade)
  jenis     String
  namaFile  String @map("nama_file")
  mimeType  String @map("mime_type")
  ukuran    Int
  data      Bytes
  createdAt String @map("created_at")

  @@unique([muridId, jenis])
  @@map("murid_dokumen")
}

model Pkbm {
  id                 Int           @id @default(autoincrement())
  nama               String
  kecamatan          String        @default("")
  statusIzin         String        @default("Berizin") @map("status_izin")
  jamOperasional     String        @default("") @map("jam_operasional")
  nilaiJam           String        @default("") @map("nilai_jam")
  kepalaSekolah      String        @default("") @map("kepala_sekolah")
  nilaiKepalaSekolah String        @default("") @map("nilai_kepala_sekolah")
  fasilitas          Json          @default("[]")
  createdAt          String        @map("created_at")
  updatedAt          String        @map("updated_at")
  relawan            PkbmRelawan[]
  murid              Murid[]

  @@map("pkbm")
}

model PkbmRelawan {
  id     Int    @id @default(autoincrement())
  pkbmId Int    @map("pkbm_id")
  pkbm   Pkbm   @relation(fields: [pkbmId], references: [id], onDelete: Cascade)
  nama   String
  nilai  String @default("")
  urutan Int    @default(0)

  @@map("pkbm_relawan")
}
